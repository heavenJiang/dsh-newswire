{
  "version": 1,
  "note": "版面版式：两种模式（模型 / 节省 token）都按这里排版。sections 的 id 对应 taxonomy.json 的一级分类，顺序即版面顺序，max 为该版块最多几篇；story 控制每篇的写法；style 是给模型的写作要求；focus 是重点领域（labels 为 taxonomy 的分类 id，一级 id 含其下所有二级）：挑材料时优先、不做规则分诊，模型按技术影响力评重要度，头版至少留一篇，版块满了也多留 3 个位置，影响分析优先；labels 留空即关闭。改完在面板点「重新编排」即可看到效果。",
  "window_hours": 12,
  "min_importance": 25,
  "front": { "count": 3 },
  "sections": [
    { "id": "politics", "max": 4 },
    { "id": "macro", "max": 3 },
    { "id": "markets", "max": 3 },
    { "id": "industry", "max": 4 },
    { "id": "tech", "max": 8 },
    { "id": "study", "max": 4 },
    { "id": "society", "max": 2 }
  ],
  "story": { "lead_chars": 120, "points": 3, "point_chars": 40, "views": 3, "impact_chars": 60, "rich_items": 4, "rich_points": 6, "rich_point_chars": 60, "rich_materials": 10, "rewrite_min": 2, "rewrite_ratio": 0.25, "brief_chars": 160 },
  "plan": { "reuse_hours": 3, "reuse_changes": 6 },
  "watch": { "count": 3 },
  "verify": { "count": 4, "min_importance": 30 },
  "focus": { "name": "AI 与新技术", "labels": ["tech", "industry.ai_semis"], "boost": 20 },
  "style": "客观、准确、简洁；用简体中文写，外文报道译成中文；数字、人名、机构名照录原文；不加评论性形容词；材料里没有的不写；各家说法不一致时如实并列。"
}
